POSTGRES_USER=apex_user
POSTGRES_PASSWORD=apex_password
POSTGRES_DB=apex_marketplace
DATABASE_URL=postgresql://apex_user:apex_password@localhost:5432/apex_marketplace
FRONTEND_URL=http://localhost:3000

# Generate with: node -e "console.log(require('crypto').randomBytes(50).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-generated-secret
JWT_REFRESH_SECRET=replace-with-a-different-generated-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

DEFAULT_COMMISSION_RATE=10.00

# Publicly reachable base URL for this API (Ozow's NotifyUrl webhook must be
# able to reach it — use an ngrok/tunnel URL here for local development).
BACKEND_URL=http://localhost:3001

# Ozow (https://ozow.com) instant EFT gateway — get these from your Ozow
# merchant dashboard. Leave OZOW_IS_TEST=true until you're ready to take
# real payments; it selects Ozow's staging API and marks requests as test.
OZOW_SITE_CODE=replace-with-your-ozow-site-code
OZOW_PRIVATE_KEY=replace-with-your-ozow-private-key
OZOW_API_KEY=replace-with-your-ozow-api-key
OZOW_IS_TEST=true
