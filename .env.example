POSTGRES_USER=apex_user
POSTGRES_PASSWORD=apex_password
POSTGRES_DB=apex_marketplace
DATABASE_URL=postgresql://apex_user:apex_password@localhost:5432/apex_marketplace

# Optional — only read by `docker compose up -d --build` for the frontend
# image. Baked into the browser bundle at build time, so it must be a URL
# real users' browsers can reach. Leave unset to default to
# http://localhost:3001/api, which only works when testing the whole
# stack on one local machine.
NEXT_PUBLIC_API_URL=